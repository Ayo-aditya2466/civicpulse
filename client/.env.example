# Copy this file to `.env` (which is gitignored) and fill in real values.
# Vite only exposes variables prefixed with VITE_ to the client build.

# Base URL of the Gemini proxy.
# Local dev default (if unset) is http://localhost:3001.
# In production set this to your deployed proxy URL, e.g. https://your-proxy.onrender.com
VITE_PROXY_BASE_URL=http://localhost:3001

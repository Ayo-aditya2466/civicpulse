# Copy this file to `.env` (which is gitignored) and fill in real values.
# Do NOT commit the real .env.

# Google Gemini API key — server-side only, never exposed to the client.
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated list of browser origins allowed to call this proxy.
# Local dev default (if unset) is http://localhost:5173.
# In production set this to your deployed client URL, e.g. https://your-app.vercel.app
ALLOWED_ORIGIN=http://localhost:5173
